legend:
  ",": plains
  "^": mountain
  "T": forest
  ".": road
  ";": ashen_plains
  "Y": blighted_forest
  "1": { dungeon_entrance: northern_watch_post }
  "2": { tile: landmark, description: "The bones of a goblin camp - firepits gone cold, huts caved in under drifting ash. Whatever lived here left everything behind but its people.", announce: true }
  "3": { tile: landmark, description: "A stone shape half-swallowed by the ash, its lines too deliberate to be natural. Something has been digging around its base, recently.", announce: true }
  "4": { tile: landmark, description: "A wide, terraced scar in the earth - not a quarry, not a mine, dug with a patience nothing living seems to have. It is far from finished.", announce: true }
  "5": { dungeon_entrance: weeping_cistern }
