  "1": { tile: landmark, description: "A weathered signpost, arms pointing four ways: Wayford northeast, Millhaven southeast, Stonebridge southwest, Saltmarsh due east and further than the rest.", announce: true }
  "2": { tile: landmark, description: "A signpost just outside Wayford's gate: Millhaven south, Stonebridge southwest, Saltmarsh southeast. Every road out of this crossroads still leads somewhere, even now.", announce: true }
  "3": { tile: landmark, description: "A signpost on the north road out of Millhaven: Wayford north, Stonebridge west, Saltmarsh east. Someone still bothers to keep it upright.", announce: true }
