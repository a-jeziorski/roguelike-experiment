id: level_01
name: Stonebridge Ward

player_start_tile: road

map: |
  #########################
  ##########x@#############
  #,,,,,,,,,..,,###,,,,,,,#
  #,,,,,,,,,,,,,#L#,,,,,,,#
  #,,,,,,,,,,,,,#W#,,,,,,,#
  #,,,,,###,,,###,,,1,,,,,#
  #,,,,,##,,,,,##,,,,,2,,,#
  #,,,,,,,,,o,,,,,,,,,,,,,#
  #,,,,,,,,,,,,,,,,,,,,,,,#
  #,,,####,,,,,,,,####,,,,#
  #,,,####,3,4,,,,,,####,,#
  #,,,,,,,,,,,,,,,,,,,,,,,#
  #,,,,5,,,,,,,,,,,,,,,,,,#
