legend:
  "#": wall
  ",": plains
  ".": road
  "@": player_start
  "F": floor
  "a": { tile: stairs_up, next_level: null, description: "The town gate - barred at night, watched always. The only way in or out of Stonebridge.", announce: true }
  "c": { tile: floor, entity: stonebridge_lookout, dialogue: "Watch those hills long enough and you learn which fires are cookfires and which ones aren't. Lately, too many of the second kind.", flag_dialogue: [{ flag: stonebridge_raided, line: "Didn't see them in time. Wall held, mostly - not everyone behind it did. Doesn't feel like a job well done, watching it happen anyway." }] }
  "e": { tile: plains, entity: villager, dialogue: "Well's never run dry, not even the year everything else did. Small mercy, but I'll take it.", flag_dialogue: [{ flag: wayford_razed, line: "Word came through with a trader - Wayford's gone. Whatever came for them, I've taken to watching our own wall a little longer than I used to." }] }
  "h": { tile: plains, entity: villager, dialogue: "Lookout's been up there more than usual lately. Might be worth finding out why, if you've got the stomach for the climb." }
  "i": { tile: plains, entity: villager, dialogue: "Wall's not just for looking at - every stone in it gets checked before winter, every year, no exceptions." }
  "j": { tile: wall, entity: town_guard, dialogue: "Wall's manned day and night. Has been since before I took this post, will be after." }
  "l": { tile: plains, entity: villager, dialogue: "Keep that potion where you can reach it. Nobody out here likes to need it, but somebody always does eventually.", flag_dialogue: [{ flag: stonebridge_raided, line: "Lost the granary and two houses before the guard turned them back. Wall held. Didn't feel like it at the time." }] }
  "m": { tile: plains, entity: villager, dialogue: "Gate's barred the second the sun's down. Doesn't matter who's still on the road when it happens." }
  "b": { tile: landmark, description: "An arrow-slit facing the road, and the hills beyond it.", announce: true }
  "d": { tile: landmark, description: "The town well, iron-bound, its winch worn smooth by hands used to hauling under more than water.", announce: true }
  "f": { tile: plains, decoration: barrel }
  "g": { tile: plains, decoration: crate }
  "k": { tile: plains, item: healing_potion }
  "n": { tile: plains, decoration: fence }
  "o": { tile: plains, decoration: herb_clump }
