legend:
  "#": wall
  ".": floor
  "@": player_start
  "<": { stairs_up: null, description: "Grey daylight, filtered through the fissure's mouth - the way back out to the valley." , announce: true }
  ">": { stairs_down: level_02, description: "The caverns narrow and drop away here, the air going colder - the way deeper into the warren." }
