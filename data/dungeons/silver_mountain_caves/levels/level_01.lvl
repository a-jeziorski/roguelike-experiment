  "#": wall
  ",": plains
  ".": road
  "@": player_start
  "F": floor
  "a": { tile: stairs_up, next_level: null, description: "Grey daylight, filtered through the fissure's mouth - the way back out to the valley.", announce: true }
  "n": { tile: stairs_down, next_level: level_02, description: "The caverns narrow and drop away here, the air going colder - the way deeper into the warren." }
