legend:
  "#": wall
  ".": floor
  "@": player_start
  "<": { stairs_up: level_01, description: "The winding way back up to the Upper Reaches and, eventually, daylight." }
  "D": { stairs_down: null, description: "A narrow crack in the rock, cold air and grey light bleeding through it from somewhere above - not the way you came in, but a way out all the same.", announce: true }
