legend:
  "#": wall
  ",": plains
  ".": road
  ":": floor
  "@": player_start
  "x": { stairs_up: null, description: "Wayford's north gate, standing open on a hinge that never got the chance to close. The high road still runs through it, same as always - what's past it doesn't, anymore.", announce: true }
  "+": { tile: landmark, description: "Ash where the cart-wheels used to wear the stone smooth. The roads still meet here - they're the only thing that still does.", announce: true }
  "R": { tile: landmark, description: "The Road Warden's post, empty now - whatever came down that west road, it got here before any warning could. The watch-fire's long cold.", announce: true }
  "c": { tile: landmark, description: "The Clerk's record house, gutted - what the fire didn't take, the horde didn't bother with. Whatever those old roads used to connect, nobody's writing it down anymore.", announce: true }
  "M": { tile: landmark, description: "The caravan yard, one cart still standing - burned to its frame, wheels intact, going nowhere. It never got the chance to resume anything.", announce: true }
  "P": { entity: wayford_provisioner, dialogue: "Cellar's stone all the way down - held better than the roof did. Lost people I'd known longer than I've known you, but I'm still here, and so's what's left of the stock. Coin's still good, if you've got it." }
  "y": { entity: wayford_trainer, tile: plains, dialogue: "Guards didn't make it. I did - spent longer with a blade in hand than any of them, and it showed, that night. Doesn't feel like winning. Still willing to teach what I know, if you're still willing to learn it." }
  "T": road
