legend:
  "#": wall
  ",": plains
  ".": road
  "@": player_start
  "F": floor
  "a": { tile: stairs_up, next_level: null, description: "Wayford's north gate, where the high road passes through the wall into town.", announce: true }
  "b": { tile: plains, entity: villager, dialogue: "Mind the cart tracks, they're deeper than they look. Wheel's already thrown twice this week." }
  "c": { tile: plains, entity: villager, dialogue: "Wasn't always this quiet at the crossroads. My grandmother used to talk about carts backed up past the gate, waiting their turn. Different world." }
  "d": { tile: plains, entity: villager, dialogue: "Busiest I've seen the square in months. Doesn't mean much - months aren't saying much these days." }
  "e": { tile: plains, entity: villager, dialogue: "Clerk's been going through what's left of the old records for weeks now. Word is there's a gap in them nobody's been able to fill." }
  "f": { tile: plains, entity: villager, dialogue: "Can't stop, cart's half-loaded and losing light." }
  "g": { tile: floor, entity: wayford_clerk }
  "h": { tile: plains, entity: villager, dialogue: "Guards keep saying the roads are fine. Guards also haven't left town in a while." }
  "i": { tile: plains, entity: villager, dialogue: "Caravan Master used to run a route to Millhaven, if the stories are true. Be curious to know why that stopped." }
  "j": { tile: floor, entity: wayford_road_warden, flag_dialogue: [{ flag: stonebridge_raided, line: "Heard it from a cart that turned back early - Stonebridge held the wall, but not all of it. Been saying that road wasn't safe for weeks. Wish just once I'd been wrong." }] }
  "k": { tile: road, entity: town_guard }
  "m": { tile: road, entity: town_guard }
  "n": { tile: floor, entity: wayford_caravan_master }
  "o": { tile: plains, entity: villager, dialogue: "Four roads, this town sits on. Only really use two of them anymore." }
  "p": { tile: floor, entity: wayford_trainer, dialogue: "You've been out there, killed things, done what people asked of you - that's worth more than coin, if you know where to spend it. I know where." }
  "q": { tile: plains, entity: villager, dialogue: "Provisioner's stall is worth a look, if you've got coin. Best-stocked place in town, and it's not close." }
  "t": { tile: plains, entity: villager, dialogue: "Road Warden's been asking around for someone reckless enough to deal with Broken Watch. Might be worth a word, if you're that sort." }
  "u": { tile: floor, entity: wayford_provisioner }
  "v": { tile: plains, entity: villager, dialogue: "Season's turning. Means less light to get anything done, same as it does every year." }
  "w": { tile: plains, entity: villager, dialogue: "If you're looking for excitement, you're a few roads too early. Try back when the caravans start running again." }
  "y": { tile: plains, entity: villager, dialogue: "Don't get many new faces around here. Welcome, I suppose - or apologies, depending how your trip's going." }
  "z": { tile: plains, entity: villager, dialogue: "Not much for talking, if it's all the same to you." }
  "l": { tile: landmark, description: "Three roads still meet here, worn smooth by cart-wheels that mostly don't come anymore. A fourth used to run east, if the old paving under the grass is anything to go by.", announce: true }
  "A": { tile: floor, decoration: table }
  "B": { tile: floor, decoration: bookshelf }
  "C": { tile: floor, decoration: chair }
  "D": { tile: plains, decoration: barrel }
  "E": { tile: plains, decoration: crate }
  "G": { tile: plains, decoration: fence }
  "H": { tile: floor, decoration: fireplace }
  "I": { tile: floor, decoration: barrel }
  "J": { tile: floor, decoration: crate }
  "K": { tile: floor, decoration: chest }
  "r": { tile: plains, item: healing_potion }
