id: level_01
name: The Flooded Common Room

map: |
  ##########################
  #.....x#...........#.....#
  #.@......................#
  #..../......~~~~~..#.....#
  #......#....~~~~~..#..d..#
  ########....~~~~~..#.....#
  ########....~~~~~..#...>.#
  ########....~~~~~..#.....#
  ########......d....#.....#
  ########..k........#.....#
  #############D############
  ##########.......#########
  ##########...[...#########
  ##########.......#########
  ##########################

legend:
  "#": wall
  ".": floor
  "@": player_start
  "x": stairs_up
  "~": { tile: sea, description: "Standing water, deep enough to swallow the old floor. Better to go around than through." }
  ">": { stairs_down: level_02 }
  "D": { door: rusty_key }
  "d": { entity: drowned_wretch }
  "/": { item: rusty_dagger }
  "k": { item: rusty_key }
  "[": { item: leather_armor }
