legend:
  "#": wall
  ".": floor
  "@": player_start
  "x": { stairs_up: null, description: "A gap where the outer wall gave way - the quickest way back out to open country." }
  ">": { stairs_down: level_02, description: "A stair down into the watchtower proper, torchlight flickering at the bottom." }
  "D": { door: rusty_key }
  "k": { item: rusty_key }
  "[": { item: leather_armor }
  "=": { item: road_ledger, description: "An old duty room, half its shelving collapsed. This ledger's just been sitting on top of the wreckage - nobody here ever had a reason to move it." }
  "b": { entity: bandit }
  "r": { entity: rat }
