legend:
  "#": wall
  ",": plains
  ".": road
  "@": player_start
  "F": floor
  "a": { tile: stairs_up, next_level: null, tile_sprite: town_gate, description: "The town gate, leading back out onto the road.", announce: true }
  "B": { tile: floor, entity: millhaven_debtor, dialogue: "I know what I owe, and I know who to. Tell them I'm good for it - just not yet." }
  "C": { tile: plains, entity: escaped_prisoner, dialogue: "Made it out of that tower same as you, more or less. Warden ever come looking for me, or is he still up there thinking he runs the place?" }
  "D": { tile: plains, entity: villager, dialogue: "Can't talk. This bread won't watch itself." }
  "E": { tile: plains, entity: villager, dialogue: "Green's bigger than it used to be. More mouths too, not that anyone's counting out loud." }
  "b": { tile: road, entity: villager, dialogue: "Don't get many strangers through that gate. Mind you're not still on the road come dark." }
  "c": { tile: road, entity: town_guard, dialogue: "Keep the peace and we've got no trouble between us." }
  "e": { tile: plains, entity: villager, dialogue: "Chief's been asking after any travelers. You'd best go say hello." }
  "g": { tile: plains, entity: villager, dialogue: "Wind cuts less along this stretch, with the trees there. Somebody's doing planned right, for once." }
  "k": { tile: floor, entity: village_chief, dialogue: "So you made it after all. I was starting to think that warning was never coming - let's hear it, all of it.", flag_dialogue: [{ flag: wayford_razed, line: "Wayford's gone quiet - the kind of quiet that isn't peace. We were bracing for a horde to reach them. Looks like something else did." }] }
  "p": { tile: plains, entity: villager, dialogue: "Well's held up better than most things built before the Sundering. Can't say the same for my back, hauling from it every morning." }
  "t": { tile: plains, entity: villager, dialogue: "Somebody still turns that bed over every spring. Can't say who, exactly - it just happens, same as the well getting fixed." }
  "v": { tile: plains, entity: villager, dialogue: "Trade's thinner than it used to be. A cart came through most weeks, once. Now we make do with what's already here." }
  "y": { tile: floor, entity: shopkeeper, dialogue: "Coin still spends here, same as it always did. Rare enough these days that I don't ask where it came from." }
  "z": { tile: floor, entity: millhaven_trainer, dialogue: "Killing things and surviving quests teaches a body plenty, if it's paying attention. I can put what you've picked up to better use than instinct alone would." }
  "n": { tile: landmark, tile_sprite: notice_board, description: "A notice board beside the door, more nail holes than notices left worth reading. Whoever's in charge here still expects people to check it.", announce: true }
  "o": { tile: landmark, tile_sprite: well, description: "The town well, its rope re-tied more times than anyone remembers whose turn it was to fix it.", announce: true }
  "u": { tile: landmark, tile_sprite: mending_yard, description: "A mending yard - a cobbler's last, a whetstone, tools laid out for whoever needs them next. Nobody's charging for the use, not anymore.", announce: true }
  "A": { tile: floor, decoration: bed }
  "G": { tile: plains, decoration: tombstone }
  "H": { tile: plains, decoration: archery_target }
  "I": { tile: plains, decoration: tilled_soil }
  "J": { tile: plains, decoration: barrel }
  "K": { tile: plains, decoration: crate }
  "d": { tile: plains, decoration: fence }
  "f": { tile: plains, decoration: tree }
  "h": { tile: floor, decoration: fireplace }
  "i": { tile: floor, decoration: table }
  "j": { tile: floor, decoration: bookshelf }
  "l": { tile: floor, decoration: chair }
  "m": { tile: plains, decoration: bush }
  "q": { tile: plains, decoration: flowerbed_white }
  "r": { tile: plains, decoration: flowerbed_blue }
  "s": { tile: plains, decoration: herb_clump }
  "w": { tile: floor, decoration: chest }
