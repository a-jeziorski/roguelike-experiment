legend:
  "#": wall
  ",": plains
  ".": road
  "@": player_start
  "F": floor
  "x": { stairs_up: null, description: "The town gate, leading back out onto the road.", announce: true }
  "o": { tile: landmark, description: "The town well, its rope re-tied more times than anyone remembers whose turn it was to fix it.", announce: true }
  "M": { tile: landmark, description: "A mending yard - a cobbler's last, a whetstone, tools laid out for whoever needs them next. Nobody's charging for the use, not anymore.", announce: true }
  "1": { entity: villager, tile: road, dialogue: "Don't get many strangers through that gate. Mind you're not still on the road come dark." }
  "2": { entity: villager, tile: plains, dialogue: "Well's held up better than most things built before the Sundering. Can't say the same for my back, hauling from it every morning." }
  "3": { entity: villager, tile: plains, dialogue: "Trade's thinner than it used to be. A cart came through most weeks, once. Now we make do with what's already here." }
  "4": { entity: villager, tile: plains, dialogue: "Can't talk. This bread won't watch itself." }
  "5": { entity: villager, tile: plains, dialogue: "Chief's been asking after any travelers. You'd best go say hello." }
  "V": { entity: village_chief, dialogue: "So you made it after all. I was starting to think that warning was never coming - let's hear it, all of it.", flag_dialogue: [{ flag: wayford_razed, line: "Wayford's gone quiet - the kind of quiet that isn't peace. We were bracing for a horde to reach them. Looks like something else did." }] }
  "6": { entity: escaped_prisoner, tile: plains, dialogue: "Made it out of that tower same as you, more or less. Warden ever come looking for me, or is he still up there thinking he runs the place?" }
  "7": { entity: shopkeeper, dialogue: "Coin still spends here, same as it always did. Rare enough these days that I don't ask where it came from." }
  "8": { entity: town_guard, tile: road, dialogue: "Keep the peace and we've got no trouble between us." }
  "y": { entity: millhaven_trainer, tile: plains, dialogue: "Killing things and surviving quests teaches a body plenty, if it's paying attention. I can put what you've picked up to better use than instinct alone would." }
