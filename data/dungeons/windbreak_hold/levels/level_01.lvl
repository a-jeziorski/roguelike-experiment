legend:
  "#": wall
  ",": plains
  "@": player_start
  "x": { stairs_up: null, description: "Back out past the windbreak wall - the wind picks up again within a few steps of the gap.", announce: true }
  "E": { entity: windbreak_captain, tile: plains, dialogue: "The Windrest still stands - real walls, a real roof. Whoever's holed up in there isn't doing anything with it. Just sitting on the one dry room for a hundred miles." }
  "1": { entity: villager, tile: plains, dialogue: "This wall won't hold in a real blow, but it's held every one so far. Ask me again next season." }
  "2": { entity: villager, tile: plains, dialogue: "Land out here's good, if anyone could stand to work it long. One good storm and you remember why nobody has." }
