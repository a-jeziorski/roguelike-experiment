  "b": { tile: floor, item: healing_potion }
  "c": { tile: floor, item: rusty_dagger, description: "A dagger, dropped or discarded near the door - whoever it belonged to didn't think it was worth the weight." }
  "f": { tile: floor, item: leather_armor, description: "A stiff leather jerkin, patched more than once. Somebody's spare, left where it fell." }
  "k": { tile: floor, decoration: barrel }
  "l": { tile: floor, decoration: crate }
