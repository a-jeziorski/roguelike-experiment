legend:
  "#": wall
  ",": floor
  "@": player_start
  "x": { stairs_down: null, description: "The Storm Door, iron-braced and still sound - the one thing here anybody's bothered to actually maintain, on both sides of it.", announce: true }
  "b": { entity: bandit }
  "C": { entity: windrest_captain }
  "!": { item: healing_potion }
  "/": { item: rusty_dagger, description: "A dagger, dropped or discarded near the door - whoever it belonged to didn't think it was worth the weight." }
  "[": { item: leather_armor, description: "A stiff leather jerkin, patched more than once. Somebody's spare, left where it fell." }
