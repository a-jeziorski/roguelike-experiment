legend:
  "#": wall
  ".": floor
  "@": player_start
  "<": { stairs_up: level_01 }
  ">": { stairs_down: level_03 }
  "D": { door: rusty_key }
  "G": { entity: guard }
  "p": { entity: feral_prisoner }
  "k": { item: rusty_key }
  ")": { item: iron_sword }
  "$": { item: gold_pile, description: "A guard's wages, kept close instead of banked - there was nowhere left to bank it." }
