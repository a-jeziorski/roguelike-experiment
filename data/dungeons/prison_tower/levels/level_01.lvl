id: level_01
name: The Solitary Cell

map: |
  ########################
  #....x.#################
  #.@....#################
  #......#################
  #......#################
  ###.####################
  ###.####################
  ###.####################
  #.!............###.....#
  #./....G$......###.....#
  #......................#
  #..............###..C..#
  #..............###..>..#
  #......T.......###.}...#
  ########################

legend:
  "#": wall
  ".": floor
  "@": player_start
  "x": stairs_up
  ">": { stairs_down: level_02 }
  "G": { entity: guard }
  "C": { entity: crossbow_guard }
  "/": { item: rusty_dagger }
  "}": { item: hunting_bow }
  "!": { item: healing_potion, description: "A guard's basic kit, kept at the post for exactly the kind of trouble a post like this expects.", announce: true }
  "$": { item: gold_pile, description: "A guard's own coin, still in the pouch he never got to spend it from.", announce: true }
  "T": { item: thorned_plate }
