id: level_01
name: The Solitary Cell

map: |
  ########################
  #....x.#################
  #.@....#################
  #......#################
  #......#################
  ###.####################
  ###.####################
  ###.####################
  #..............###.....#
  #./....G$......###.....#
  #......................#
  #..............###..C..#
  #..............###..>..#
  #..............###.}...#
  ########################

legend:
  "#": wall
  ".": floor
  "@": player_start
  "x": stairs_up
  ">": { stairs_down: level_02 }
  "G": { entity: guard }
  "C": { entity: crossbow_guard }
  "/": { item: rusty_dagger }
  "}": { item: hunting_bow }
  "$": { item: gold_pile, description: "A guard's own coin, still in the pouch he never got to spend it from." }
