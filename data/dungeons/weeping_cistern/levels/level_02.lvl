id: level_02
name: The Flooded Vault

map: |
  ##########################
  #FhFFFF#########FFFFFFFFF#
  #FFFFFF#########FFFFFFFFF#
  #FFFFFp~~~~~~~~~FFFFFsFcF#
  #u@FFFF~~~~~~~~~FFFmFFFFF#
  #FFFFFF~~~~~~~~~FrFFFFFFF#
  #FFFFFF#########FFFFeFFFF#
  #FFFFFF#########FFFFFFFFF#
