id: level_02
name: The Foreman's Gallery

map: |
  #############################
  #<@..########################
  #....########################
  ####.########################
  ####.########################
  ##..r........################
  ##........g.|################
  ##.######....}....###########
  ##.######.####....######..>.#
  ##.g..-...######..~~~~~~....#
  ###D############..~~~~~~.####
  ##.e..##########..~~~~~~.####
  ##..).##########......g..####
  ################!........####
  #############################

legend:
  "#": wall
  ".": floor
  "@": player_start
  "<": { stairs_up: level_01 }
  ">": { stairs_down: level_03 }
  "r": { entity: rat }
  "g": { entity: goblin }
  "-": { item: rusty_key }
  "}": { item: hunting_bow }
  "|": { item: arrows }
  "D": { door: rusty_key }
  "e": { tile: floor, description: "A ledger, open to its last page. The entries are ordinary - cart counts, a note about a squeaky axle - right up until the final line, which trails off mid-word." }
  ")": { item: iron_sword }
  "~": { tile: sea, description: "Groundwater, pooled ankle-deep and rising. Nobody's pumped this gallery since the office that used to schedule it stopped answering." }
  "!": { item: healing_potion }
