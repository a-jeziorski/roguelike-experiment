id: level_03
name: The Last Vein

map: |
  #########################
  #<@.#####################
  #..!#####################
  ###.#####################
  ###.#####################
  ###.#############.MMMMM.#
  #............####...p...#
  #..r.....g...####.......#
  #.....n........|....s...#
  #............####.......#
  #...g.....r..####.......#
  #............####..>....#
  #################.......#
  #########################
  #########################

legend:
  "#": wall
  ".": floor
  "@": player_start
  "<": { stairs_up: level_02 }
  ">": stairs_down
  "!": { item: healing_potion }
  "r": { entity: rat }
  "g": { entity: goblin }
  "s": { entity: skeleton }
  "n": { tile: landmark, description: "A nest built from things that used to belong to someone else - gnawed timber, a stolen glove, a coil of rope chewed to fiber. Rats first, by the look of it. Whatever moved in after never bothered clearing them out." }
  "|": { item: arrows }
  "M": { tile: mountain, description: "The rock face the mine was cutting toward, sealed by a fall that was never cleared. This is where the last shift stopped - not by choice." }
  "p": { tile: landmark, description: "A pick, still lodged in the rock at chest height, exactly where it was swung and left." }
