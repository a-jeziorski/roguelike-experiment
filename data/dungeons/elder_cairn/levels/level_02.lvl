id: level_02
name: The Heart of the Cairn

map: |
  ########################
  #########...>..#########
  #########......#########
  ###########..###########
  ###########..###########
  #########...^..#########
  #########...Y..#########
  #######..........#######
  #######..........#######
  #######..........#######
  #...#######..#######...#
  #.].####........####.!.#
  #.Q..................Q.#
  #...####........####...#
  #...#######..#######...#
  ###########..###########
  ###########..###########
  #########......#########
  #########..@...#########
  ########################

legend:
  "#": wall
  ".": floor
  "@": player_start
  ">": { stairs_down: null, description: "The passage climbs back toward the grey light above - you have gone as deep as this place allows.", announce: true }
  "Q": { entity: stone_sentinel }
  "]": { item: bone_plate }
  "!": { item: healing_potion }
  "Y": { entity: wraith }
  "^": { tile: landmark, description: "A single stone set into the floor, smaller than anything else in the Cairn and matching none of it - no grown curve, no seam, nothing to place it by. It's colder than the air around it." }
